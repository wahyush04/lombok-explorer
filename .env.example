# =============================================================================
# Lombok Explorer Backend API — Environment Configuration Template
# Copy this file to .env and configure values as needed
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=8080
API_PREFIX=/v1
HOST=0.0.0.0

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://root:root@localhost:5432/lombok_explorer?schema=public"
DB_USER=root
DB_PASSWORD=root
DB_NAME=lombok_explorer
DB_PORT=5432

# JWT Authentication (Access: 15 minutes, Refresh: 7 days)
JWT_ACCESS_SECRET="lombok_explorer_super_secret_access_jwt_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="lombok_explorer_super_secret_refresh_jwt_key_2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & CORS
CORS_ORIGIN="*"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging (debug, info, warn, error)
LOG_LEVEL=debug

# Weather API (Live WeatherAPI.com)
WEATHER_API_KEY=e98c7ab33f21494199425936251005
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1
WEATHER_CACHE_TTL_SECONDS=600

# Development Admin Account Seeding (For local dev & QA only)
# WARNING: Do not use default credentials in production!
ADMIN_EMAIL=wahyush04.colab@example.com
ADMIN_PASSWORD=lombokExplorer@2026
ADMIN_NAME="Super Admin Lombok Explorer"

# Google Sign-In OAuth Configuration
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
