// Lombok Explorer — Prisma Schema
// Single Source of Truth for Relational Database Modeling

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum LombokRegion {
  LOMBOK_SELATAN // Kuta, Mandalika, Tanjung Aan, Merese, Mawun, Selong Belanak
  LOMBOK_UTARA // Senaru, Rinjani, Tiu Kelep, Bayan, Gili Islands
  LOMBOK_BARAT // Senggigi, Malimbu, Sekotong, Batu Layar
  LOMBOK_TIMUR // Sembalun, Pink Beach, Tetebatu
  LOMBOK_TENGAH // Sade, Sukarara, Praya
  GILI_ISLANDS // Trawangan, Meno, Air
}

enum DifficultyLevel {
  EASY
  MODERATE
  CHALLENGING
  EXTREME
}

enum TravelStyle {
  NATURE_ADVENTURE
  BEACH_RELAXATION
  CULTURE_HERITAGE
  CULINARY_EXPLORER
  PHOTOGRAPHY_SPOTS
  FAMILY_FRIENDLY
}

enum BudgetLevel {
  BUDGET
  MID_RANGE
  LUXURY
}

enum TransportationMode {
  CAR
  MOTORCYCLE
  WALKING
  CYCLING
  PUBLIC_TRANSPORT
}

enum ExpenseCategory {
  TRANSPORT
  ACCOMMODATION
  FOOD
  ACTIVITY
  SHOPPING
  LODGING
  TICKET
  SOUVENIR
  OTHER
}

enum ChecklistCategory {
  BEACH
  TREKKING
  GENERAL
  CLOTHING
  DOCUMENTS
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DestinationStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  DELETED
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  HARASSMENT
  FRAUD
  MISLEADING
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

// ==========================================
// USER MANAGEMENT & AUTHENTICATION
// ==========================================

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  username        String        @unique
  password        String?
  name            String
  avatarUrl       String?       @db.Text
  phone           String?
  role            UserRole      @default(USER)
  status          UserStatus    @default(ACTIVE)
  travelStyle     TravelStyle?
  preferredRegion LombokRegion?
  isEmailVerified Boolean       @default(false)
  refreshToken    String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  // Relations
  identities    AuthIdentity[]
  favorites     Favorite[]
  reviews       Review[]
  itineraries   Itinerary[]
  expenses      Expense[]
  journals      TravelJournal[]
  checklists    Checklist[]
  auditLogs     AuditLog[]
  posts         Post[]
  postLikes     PostLike[]
  postComments  PostComment[]
  postBookmarks PostBookmark[]
  postReports   PostReport[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model AuthIdentity {
  id                String       @id @default(uuid())
  userId            String
  provider          AuthProvider
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_identities")
}

// ==========================================
// CATEGORIES & DESTINATIONS
// ==========================================

model Category {
  id            String            @id @default(uuid())
  slug          String            @unique
  name          String
  description   String            @db.Text
  iconName      String
  coverImageUrl String            @db.Text
  status        DestinationStatus @default(PUBLISHED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  // Relations
  destinations Destination[]

  @@index([slug])
  @@index([status])
  @@map("categories")
}

model Destination {
  id                       String            @id @default(uuid())
  slug                     String            @unique
  name                     String
  shortDescription         String            @db.Text
  description              String            @db.Text
  categoryId               String
  category                 Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  region                   LombokRegion
  locationName             String
  address                  String?           @db.Text
  latitude                 Float
  longitude                Float
  rating                   Float             @default(0.0)
  reviewCount              Int               @default(0)
  entranceFee              Decimal           @default(0) @db.Decimal(12, 2)
  currency                 String            @default("IDR")
  openingHours             String
  estimatedDurationMinutes Int               @default(60)
  bestVisitingTime         String
  difficulty               DifficultyLevel   @default(EASY)
  tags                     String            @db.Text // JSON array: ["Pasir Merica", "Sunset"]
  coverImageUrl            String            @db.Text
  facilities               String            @db.Text // JSON array: ["Area Parkir", "Toilet"]
  tips                     String?           @db.Text // JSON array: ["Kunjungi saat sore"]
  status                   DestinationStatus @default(PUBLISHED)
  isFeatured               Boolean           @default(false)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  deletedAt                DateTime?

  // Relations
  images                     DestinationImage[]
  reviews                    Review[]
  favorites                  Favorite[]
  itineraryItems             ItineraryItem[]
  templateActivities         TemplateActivity[]
  recommendationDestinations RecommendationDestination[]
  posts                      Post[]
  postLocations              PostLocation[]

  @@index([categoryId])
  @@index([region])
  @@index([rating])
  @@index([isFeatured])
  @@index([status])
  @@index([latitude, longitude])
  @@map("destinations")
}

model DestinationImage {
  id            String      @id @default(uuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  imageUrl      String      @db.Text
  caption       String?
  altText       String?
  orderIndex    Int         @default(0)
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt

  @@index([destinationId])
  @@index([orderIndex])
  @@map("destination_images")
}

// ==========================================
// USER INTERACTIONS: FAVORITES & REVIEWS
// ==========================================

model Favorite {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, destinationId])
  @@index([userId])
  @@index([destinationId])
  @@map("favorites")
}

model Review {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  rating        Float
  content       String       @db.Text
  photos        String?      @db.Text // JSON array of photo URLs
  status        ReviewStatus @default(APPROVED)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([destinationId])
  @@index([userId])
  @@index([rating])
  @@index([status])
  @@map("reviews")
}

// ==========================================
// ITINERARY TEMPLATES (CURATED / ADMIN)
// ==========================================

model ItineraryTemplate {
  id                     String             @id @default(uuid())
  title                  String
  description            String?            @db.Text
  coverImageUrl          String?            @db.Text
  totalDays              Int                @default(1)
  travelStyle            TravelStyle        @default(BEACH_RELAXATION)
  budgetLevel            BudgetLevel        @default(MID_RANGE)
  transportationMode     TransportationMode @default(CAR)
  transportPaceNote      String?            // e.g. "Mobil Sewa / Motor • Santai & Menyenangkan"
  totalEstimatedBudget   Decimal            @default(0) @db.Decimal(12, 2)
  totalDistanceKm        Float              @default(0)
  totalDurationMinutes   Int                @default(0)
  isPublished            Boolean            @default(true)
  isFeatured             Boolean            @default(false)
  sortOrder              Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?

  // Relations
  days                   TemplateDay[]
  itineraries            Itinerary[]

  @@index([isPublished])
  @@index([isFeatured, sortOrder])
  @@index([travelStyle])
  @@index([totalDays])
  @@map("itinerary_templates")
}

model TemplateDay {
  id                   String            @id @default(uuid())
  templateId           String
  template             ItineraryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dayNumber            Int
  title                String
  notes                String?           @db.Text
  totalDistanceKm      Float             @default(0)
  totalDurationMinutes Int               @default(0)
  estimatedBudget      Decimal           @default(0) @db.Decimal(12, 2)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Relations
  activities           TemplateActivity[]

  @@unique([templateId, dayNumber])
  @@index([templateId])
  @@map("template_days")
}

model TemplateActivity {
  id                        String       @id @default(uuid())
  templateDayId             String
  templateDay               TemplateDay  @relation(fields: [templateDayId], references: [id], onDelete: Cascade)
  destinationId             String?
  destination               Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  customLocation            String?      @db.Text // JSON: { name, latitude, longitude, address }
  customTitle               String?
  orderIndex                Int
  startTime                 String?      // e.g. "08:30"
  endTime                   String?      // e.g. "10:30"
  activityNotes             String?      @db.Text
  estimatedDurationMinutes  Int          @default(60)
  estimatedCost             Decimal      @default(0) @db.Decimal(12, 2)
  distanceFromPrevKm        Float        @default(0)
  travelTimeFromPrevMinutes Int          @default(0)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@index([templateDayId])
  @@index([destinationId])
  @@index([orderIndex])
  @@map("template_activities")
}

// ==========================================
// USER ITINERARIES (PRIVATE & USER-OWNED)
// ==========================================

model Itinerary {
  id                     String             @id @default(uuid())
  userId                 String?
  user                   User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  templateId             String?
  template               ItineraryTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title                  String
  description            String?            @db.Text
  coverImageUrl          String?            @db.Text
  totalDays              Int                @default(1)
  totalEstimatedBudget   Decimal            @default(0) @db.Decimal(12, 2)
  travelStyle            TravelStyle        @default(BEACH_RELAXATION)
  budgetLevel            BudgetLevel        @default(MID_RANGE)
  pace                   String             @default("BALANCED") // RELAXED, BALANCED, INTENSE
  transportationMode     TransportationMode @default(CAR)
  startLocation          String?            @db.Text // JSON: { name, latitude, longitude, address }
  endLocation            String?            @db.Text // JSON: { name, latitude, longitude, address }
  totalDistanceKm        Float              @default(0)
  totalTravelTimeMinutes Int                @default(0)
  isCustom               Boolean            @default(false)
  isPublic               Boolean            @default(false)
  isSaved                Boolean            @default(true)
  shareToken             String?            @unique
  startDate              DateTime?
  endDate                DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?

  // Relations
  days     ItineraryDay[]
  expenses Expense[]

  @@index([userId])
  @@index([templateId])
  @@index([travelStyle])
  @@index([budgetLevel])
  @@index([shareToken])
  @@map("itineraries")
}

model ItineraryDay {
  id                     String          @id @default(uuid())
  itineraryId            String
  itinerary              Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayNumber              Int
  title                  String
  date                   DateTime?
  notes                  String?         @db.Text
  totalDistanceKm        Float           @default(0)
  totalTravelTimeMinutes Int             @default(0)
  estimatedBudget        Decimal         @default(0) @db.Decimal(12, 2)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Relations
  items ItineraryItem[]

  @@unique([itineraryId, dayNumber])
  @@index([itineraryId])
  @@map("itinerary_days")
}

model ItineraryItem {
  id                        String       @id @default(uuid())
  itineraryDayId            String
  itineraryDay              ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  destinationId             String?
  destination               Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  customLocation            String?      @db.Text // JSON: { name, latitude, longitude, address }
  customTitle               String?
  orderIndex                Int
  startTime                 String?      // e.g. "08:30"
  endTime                   String?      // e.g. "10:30"
  timeSlot                  String?      // e.g. "08:30 - 10:30"
  activityNotes             String?      @db.Text
  estimatedDurationMinutes  Int          @default(60)
  estimatedCost             Decimal      @default(0) @db.Decimal(12, 2)
  distanceFromPrevKm        Float        @default(0)
  travelTimeFromPrevMinutes Int          @default(0)
  isCompleted               Boolean      @default(false)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@index([itineraryDayId])
  @@index([destinationId])
  @@index([orderIndex])
  @@map("itinerary_items")
}

// ==========================================
// RECOMMENDATIONS ENGINE
// ==========================================

model Recommendation {
  id              String      @id @default(uuid())
  title           String
  subtitle        String
  bannerUrl       String      @db.Text
  travelStyle     TravelStyle
  budgetLevel     BudgetLevel @default(MID_RANGE)
  recommendedDays Int         @default(3)
  estimatedBudget Decimal     @default(0) @db.Decimal(12, 2)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  destinations RecommendationDestination[]

  @@index([travelStyle])
  @@index([budgetLevel])
  @@map("recommendations")
}

model RecommendationDestination {
  id               String         @id @default(uuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  destinationId    String
  destination      Destination    @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  orderIndex       Int            @default(0)

  @@unique([recommendationId, destinationId])
  @@index([recommendationId])
  @@index([destinationId])
  @@map("recommendation_destinations")
}

// ==========================================
// CULINARY & ACCOMMODATIONS
// ==========================================

model Restaurant {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  description      String            @db.Text
  cuisineType      String
  specialtyDish    String
  priceRange       String
  minPrice         Decimal           @default(0) @db.Decimal(12, 2)
  maxPrice         Decimal           @default(0) @db.Decimal(12, 2)
  rating           Float             @default(0.0)
  reviewCount      Int               @default(0)
  address          String            @db.Text
  region           LombokRegion
  latitude         Float
  longitude        Float
  openingHours     String
  coverImageUrl    String            @db.Text
  images           String            @db.Text // JSON array of image URLs
  isHalalCertified Boolean           @default(true)
  status           DestinationStatus @default(PUBLISHED)
  isFeatured       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  @@index([region])
  @@index([cuisineType])
  @@index([rating])
  @@index([status])
  @@index([isFeatured])
  @@map("restaurants")
}

model Accommodation {
  id            String            @id @default(uuid())
  name          String
  slug          String            @unique
  type          String // resort, villa, hotel, homestay, glamping
  description   String            @db.Text
  rating        Float             @default(0.0)
  reviewCount   Int               @default(0)
  pricePerNight Decimal           @db.Decimal(12, 2)
  currency      String            @default("IDR")
  address       String            @db.Text
  region        LombokRegion
  latitude      Float
  longitude     Float
  coverImageUrl String            @db.Text
  images        String            @db.Text // JSON array of image URLs
  amenities     String            @db.Text // JSON array of amenities
  contactPhone  String?
  websiteUrl    String?           @db.Text
  status        DestinationStatus @default(PUBLISHED)
  isFeatured    Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  @@index([region])
  @@index([type])
  @@index([pricePerNight])
  @@index([rating])
  @@index([status])
  @@index([isFeatured])
  @@map("accommodations")
}

// ==========================================
// BUDGET, EXPENSES, JOURNALS & CHECKLISTS
// ==========================================

model Expense {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraryId String?
  itinerary   Itinerary?      @relation(fields: [itineraryId], references: [id], onDelete: SetNull)
  category    ExpenseCategory @default(OTHER)
  title       String
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("IDR")
  date        DateTime        @default(now())
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([itineraryId])
  @@index([category])
  @@map("expenses")
}

model TravelJournal {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  content      String    @db.Text
  locationName String?
  date         DateTime  @default(now())
  photos       String?   @db.Text // JSON array of photo URLs
  isPublic     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([userId])
  @@index([date])
  @@map("travel_journals")
}

model Checklist {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  category  ChecklistCategory @default(GENERAL)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Relations
  items ChecklistItem[]

  @@index([userId])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(uuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  itemText    String
  isChecked   Boolean   @default(false)
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([checklistId])
  @@map("checklist_items")
}

// ==========================================
// WEATHER CACHE
// ==========================================

model WeatherCache {
  id                String       @id @default(uuid())
  region            LombokRegion @unique
  locationName      String
  condition         String
  tempCelsius       Int
  feelsLikeCelsius  Int
  humidityPercent   Int
  windSpeedKmh      Float
  uvIndex           Int
  iconName          String
  recommendationTip String       @db.Text
  forecast          String       @db.Text // JSON array of 5-day forecast objects
  lastUpdated       DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([region])
  @@map("weather_cache")
}

// ==========================================
// AUDIT LOGS (ADMIN OPERATIONS)
// ==========================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // CREATE, UPDATE, DELETE, MODERATE, LOGIN, LOGOUT
  entity    String // Destination, Category, Review, User, Restaurant, Accommodation, etc.
  entityId  String?
  oldValues String?  @db.Text // JSON string of before state
  newValues String?  @db.Text // JSON string of after state
  details   String?  @db.Text // JSON string of operation metadata
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// FEEDS & SOCIAL COMMUNITY MODULE
// ==========================================

model Post {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String       @db.VarChar(150)
  description   String       @db.Text
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  locationName  String?
  latitude      Float?
  longitude     Float?
  status        PostStatus   @default(PUBLISHED)
  likeCount     Int          @default(0)
  commentCount  Int          @default(0)
  shareCount    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  // Relations
  location  PostLocation?
  media     PostMedia[]
  likes     PostLike[]
  comments  PostComment[]
  bookmarks PostBookmark[]
  reports   PostReport[]

  // Indexes optimized for deterministic cursor-based queries
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([destinationId, status])
  @@index([createdAt])
  @@map("posts")
}

model PostLocation {
  id            String       @id @default(uuid())
  postId        String       @unique
  post          Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  name          String
  latitude      Float
  longitude     Float
  address       String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([destinationId])
  @@index([latitude, longitude])
  @@map("post_locations")
}

model PostMedia {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String   @db.Text
  type      String   @default("IMAGE") // IMAGE, VIDEO
  sortOrder Int      @default(0)
  caption   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([postId, sortOrder])
  @@map("post_media")
}

model PostLike {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model PostComment {
  id        String    @id @default(uuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([postId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId])
  @@map("post_comments")
}

model PostBookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([postId])
  @@map("post_bookmarks")
}

model PostReport {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId      String
  post        Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  reason      ReportReason
  description String?      @db.Text
  status      ReportStatus @default(PENDING)
  adminNotes  String?      @db.Text
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, postId])
  @@index([postId])
  @@index([status])
  @@index([createdAt])
  @@map("post_reports")
}
